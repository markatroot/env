# Two-line prompt (One Dark colors):
#   ╭─ user@host · dir · ⎇ branch
#   ╰─❯            (or ╰─✗<code> ❯ after a failed command)
# Must run first in PROMPT_COMMAND so $? is still the last command's status.
function __set_ps1() {
  local status=$?

  # Linux virtual console (TTY): no truecolor or box-drawing glyphs, keep it plain
  if [ "$TERM" = "linux" ]; then
    PS1='\u@\W \$ '
    return $status
  fi

  local gray='\[\e[38;2;92;99;112m\]'      # #5c6370
  local yellow='\[\e[38;2;229;192;123m\]'  # #e5c07b
  local green='\[\e[38;2;152;195;121m\]'   # #98c379
  local magenta='\[\e[38;2;198;120;221m\]' # #c678dd
  local red='\[\e[38;2;224;108;117m\]'     # #e06c75
  local reset='\[\e[0m\]'

  local git=""
  local branch
  branch=$(git branch --show-current 2>/dev/null)
  # detached HEAD: fall back to the short hash
  [ -z "$branch" ] && branch=$(git rev-parse --short HEAD 2>/dev/null)
  if [ -n "$branch" ]; then
    git=" ${gray}·${reset} ${magenta}⎇ ${branch}${reset}"
  fi

  local arrow
  if [ "$status" -eq 0 ]; then
    arrow="${green}❯${reset}"
  else
    arrow="${red}✗${status} ❯${reset}"
  fi

  PS1="${gray}╭─${reset} ${yellow}\u${gray}@\h${reset} ${gray}·${reset} ${green}\W${reset}${git}\n${gray}╰─${reset}${arrow} "
  return $status
}


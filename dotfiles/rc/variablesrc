function parse_git_branch() {
  if git rev-parse --is-inside-work-tree &>/dev/null; then
    local branch=$(git branch --show-current 2>/dev/null)
    if [ -n "$branch" ]; then
      echo -e " on \e[38;2;245;116;190m $branch\e[0m"
    fi
  fi
}
export PS1='\[\e[38;2;206;203;0m\]\u\[\e[0m\] in \[\e[38;2;80;250;123m\]\W\[\e[0m\]$(parse_git_branch)\n\[\e[38;2;80;250;123m\]❯\[\e[0m\] '


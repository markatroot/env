#!/bin/bash

# source /home/$USER/env/dotfiles/rc/colorrc
source /home/$USER/env/dotfiles/rc/themerc
source /home/$USER/env/dotfiles/rc/variablesrc
source /home/$USER/env/dotfiles/rc/aliasrc
source /home/$USER/env/dotfiles/rc/privaterc
source /home/$USER/env/dotfiles/rc/pathrc
source /home/$USER/env/dotfiles/rc/functionrc

set -o vi
bind -f  /home/$USER/env/dotfiles/inputrc
bind '"jj":vi-movement-mode'

WHEREFILE="/home/$USER/Documents/Temp/whereami"
export PROMPT_COMMAND="__set_ps1; pwd > $WHEREFILE"
if test -f "$WHEREFILE"; then
  # if the terminal is not opened with specified work directory
  if [ "$(pwd)" == "/home/$USER" ]; then
    cd $(cat $WHEREFILE)
  fi
fi

# eval "$(starship init bash)"

shopt -s histappend  # Enable appending to the history file

eval "$(ssh-agent -s)" > /dev/null

for file in ~/env/dotfiles/scripts/*; do
  source "$file"
done

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init --cmd cd bash)"
fi
